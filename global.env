# This variables are used inside containers. For variables usage in docker-compose.yml use .env file or directive "substitute_env_file:"
# PHP settings
PHP_MEMORY_LIMIT=512M
PHP_ENABLE_XDEBUG=false
PHP_ENABLE_APCU=false
UPLOAD_MAX_FILESIZE=100M
POST_MAX_SIZE=100M
MAX_EXECUTION_TIME=180

# Variable for using xdebux via PHPSTORM
PHP_IDE_CONFIG="serverName=vscode"

# How data volume is used. Variables: "local" or "dockervolume". In case of "local" folder from local HDD is mapped to container. In case of "dockervolume" native docker volume is used (data has to be copied to this volume and data is accesible only from within container. It is stored in /var/lib/docker/volumes). 
VOLUME_TYPE=local
WEB_ROOT=/var/www/html

# Update UID and GID of www-data default user. Will set same access as for Magento_root folder (Valid only if VOLUME_TYPE=local)
UPDATE_UID=true
UPDATE_GID=true

# If UPDATE_UID_GID_MANUAL=true UID and GID has to be set to curent local user (Valid only if VOLUME_TYPE=local)
UPDATE_UID_GID_MANUAL=false
UID=1000
GID=1000

# If UPDATE_USER=true, startup script updates M2 folder owner to www-data (Valid only if VOLUME_TYPE=local)
UPDATE_USER=false

# If true, startup script updates Magento folder with proper accesses.
UPDATE_FILEFOLDER_PERMISIONS=false

# DEBUG=true allows to track all commands and write them to container log. Mainly used for tracking errors by building containers
DEBUG=false
CRON=true
#CRON_TASK_WEB_USER=* * * * * echo "TEST 0" >> $WEB_ROOT/storage/logs/test_0.log#
CRON_TASK_WEB_USER=* * * * * /usr/local/bin/php /var/www/html/artisan schedule:run >> $WEB_ROOT/storage/logs/cron.log 2>&1
##*/5 * * * * echo "TEST 1" >> $MAGENTO_ROOT/var/log/test_1.log
#CRON_TASK_WEB_USER=05 06 * * * /var/www/html/bin/downloadFeaturedProductsCsv.sh 2>&1 | grep -v "CSV files download by schedule" >> /var/www/html/var/log/custom.cron#05 05 03 * * /var/www/html/bin/scripts/exportInvoicesLastMonth.sh 2>&1 | grep -v "Invoice Export by schedule" >> /var/www/html/var/log/custom.cron#05 07 * * 05 /usr/local/bin/php -f /var/www/html/bin/scripts/exportCategories.php 2>&1 | grep -v "Invoice Export by schedule" >> /var/www/html/var/log/custom.cron
#CRON_TASK_ROOT=*/2 * * * * echo "TEST 2" >> /var/www/html/var/log/test_root.log

# Custom nginx settings
FPM_HOST=php-fpm
FPM_PORT=9000

# Nullmailer config
ADMIN_ADDRESS=admin@vegadesign.cz
DEFAULT_DOMAIN=billex.local
REMOTES='mailhog smtp --port=1025'

# Used in adminer.conf
SERVER_NAME_DB=billex-dev.db.local
