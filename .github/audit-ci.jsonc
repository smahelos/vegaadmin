{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "allowlist": [],
  // Prints an allowlisted advisory that no longer occurs, so a stale entry shows in the log
  "show-not-found": true,
  "report-type": "summary",
  "extra-args": ["--package-lock-only"]
}
