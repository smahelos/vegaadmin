APP_NAME=Billex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://billex-dev.local

APP_LOCALE=cs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker stack (docker-compose.yaml): container names, container host names, bind-mounted data
CONTAINER_PREFIX=BILLEX
BASE_NAME=billex-dev
BASE_HOST=local
DATA_DIR=./data
# UID/GID of the host user that owns the project (id -u / id -g); the source is bind-mounted
WWW_UID=1000
WWW_GID=1000

# DB_HOST is the database service of docker-compose.yaml
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=billex
DB_USERNAME=billex
DB_PASSWORD=
DB_ROOT_USERNAME=root
DB_ROOT_PASSWORD=

# MCP MySQL (host access, use a database account with SELECT-only grants)
MCP_MYSQL_HOST=127.0.0.1
MCP_MYSQL_PORT=3306
MCP_MYSQL_USERNAME=
MCP_MYSQL_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Hosts whose browser requests to /api get the web session (the frontend API: dashboard charts, form lookups).
# Without it Sanctum uses localhost plus the APP_URL host; list every production host, www. variant included.
SANCTUM_STATEFUL_DOMAINS=billex-dev.local

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# MailHog of docker-compose.yaml (web UI on http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# GoPay payment gateway (sandbox unless GOPAY_PRODUCTION=true)
GOPAY_ENABLED=false
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_PRODUCTION=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
