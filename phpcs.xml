<?xml version="1.0"?>
<ruleset name="Billex">
    <description>Layout rules Pint cannot express (.claude/rules/php.md, Formatting). Pint runs after phpcbf.</description>

    <file>app</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>database</file>
    <file>lang</file>
    <file>phpcs</file>
    <file>public</file>
    <file>routes</file>
    <file>tests</file>

    <exclude-pattern>bootstrap/cache/*</exclude-pattern>
    <exclude-pattern>*.blade.php</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg value="s"/>

    <rule ref="SlevomatCodingStandard.Functions.RequireMultiLineCall">
        <properties>
            <property name="minParametersCount" value="3"/>
        </properties>
    </rule>

    <!-- Native types in every signature (.claude/rules/php.md, Types); array shapes stay in docblocks. -->
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingTraversableTypeHintSpecification"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.ParameterTypeHint.MissingTraversableTypeHintSpecification"/>
    </rule>
    <!-- GoPay\Payments declares these parameters untyped; PHP refuses a narrower type in the subclass. -->
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint.MissingAnyTypeHint">
        <exclude-pattern>tests/Support/Fakes/GoPay/FakeGoPayPayments.php</exclude-pattern>
    </rule>

    <rule ref="./phpcs/Billex"/>
</ruleset>
