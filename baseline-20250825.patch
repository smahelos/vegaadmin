-
-    /**
-     * Convenience method for recording supplier creation
-     */
-    public function recordSupplierCreation(?User $user, string $guard = 'web'): bool
-    {
-        $bestPeriod = $this->getBestPeriodType($user, 'supplier', 'count');
-        return $this->recordUsage($user, 'supplier', 'count', $bestPeriod, $guard, 1);
