-            }
-            
-            Log::info('UELS: Usage recorded', [
-                'user_id' => $userId,
-                'entity_type' => $entityType,
-                'metric_type' => $metricType,
-                'period_type' => $periodType,
-                'value' => $value
-            ]);
-            
-            return true;
-        } catch (\Exception $e) {
