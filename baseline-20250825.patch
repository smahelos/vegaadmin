-                $oldValue = $usage->current_value;
-                $usage->current_value += $value;
-                $usage->last_reset_at = now();
-                $saved = $usage->save();
-                
-                Log::info('UELS: Updated existing usage', [
-                    'usage_id' => $usage->id,
-                    'old_value' => $oldValue,
-                    'new_value' => $usage->current_value,
-                    'save_result' => $saved ? 'success' : 'failed'
-                ]);
-            } else {
