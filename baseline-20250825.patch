diff --git a/app/Traits/RecordsEntityLimits.php b/app/Traits/RecordsEntityLimits.php
deleted file mode 100644
index f8f36b1..0000000
--- a/app/Traits/RecordsEntityLimits.php
+++ /dev/null
@@ -1,100 +0,0 @@
-<?php
-
-namespace App\Traits;
-
-use App\Services\UniversalLimitService;
-use Illuminate\Http\JsonResponse;
-use Illuminate\Http\RedirectResponse;
-
-/**
- * Universal Entity Limits Integration Trait
- * 
- * Provides automatic entity limit recording for CRUD controllers
- */
-trait RecordsEntityLimits
-{
-    /**
-     * Override the default store method to record entity limits
-     */
-    protected function store()
-    {
-        // Call the original store method
-        $response = $this->traitStore();
-        
-        // If successful creation, record usage
-        if ($this->isSuccessfulCreation($response)) {
-            $this->recordEntityUsage();
-        }
-        
-        return $response;
-    }
-    
-    /**
-     * Record entity usage after successful creation
-     */
-    protected function recordEntityUsage(): void
-    {
-        try {
-            $entityType = $this->getEntityType();
-            $user = backpack_user();
-            
-            if ($entityType && $user) {
-                $limitService = app(UniversalLimitService::class);
-                $limitService->recordUsage($user, $entityType);
-            }
-        } catch (\Exception $e) {
-            // Log error but don't fail the main operation
-            \Log::warning('Failed to record entity limit usage', [
-                'entity_type' => $this->getEntityType(),
-                'user_id' => backpack_user()?->id,
-                'error' => $e->getMessage()
-            ]);
-        }
-    }
-    
-    /**
-     * Check if the response indicates successful creation
-     */
-    protected function isSuccessfulCreation($response): bool
-    {
-        // For JSON responses (API)
-        if ($response instanceof JsonResponse) {
-            return $response->getStatusCode() >= 200 && $response->getStatusCode() < 300;
-        }
-        
-        // For redirect responses (Web)
-        if ($response instanceof RedirectResponse) {
-            // Check if it's not a redirect back with errors
-            return !session()->has('errors');
-        }
-        
-        return true;
-    }
-    
-    /**
-     * Get the entity type for limit tracking
-     * 
-     * Override this method in controllers to provide custom entity types
-     */
-    protected function getEntityType(): ?string
-    {
-        // Try to determine entity type from model class
-        $modelClass = $this->crud->model ?? null;
-        
-        if (!$modelClass) {
-            return null;
-        }
-        
-        // Extract entity type from model class name
-        $className = class_basename($modelClass);
-        
-        return match($className) {
-            'Invoice' => 'invoice',
-            'Client' => 'client',
-            'Supplier' => 'supplier', 
-            'Product' => 'product',
-            'Expense' => 'expense',
-            default => strtolower($className)
-        };
-    }
-}
