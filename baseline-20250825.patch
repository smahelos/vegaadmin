-                    'user_id' => $user->id,
-                    'permission' => $permission,
-                    'guard' => $guard
-                ]);
-                return true;
-            }
-        }
-
-        Log::info('UELS: User lacks permission for entity', [
-            'entity_type' => $entityType,
-            'user_id' => $user->id,
-            'available_permissions' => $permissionsForEntity,
-            'user_permissions' => $user->getAllPermissions()->pluck('name')->toArray()
-        ]);
-
-        return false;
-    }
-}
