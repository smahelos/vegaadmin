-                
-                Log::info('UELS: Created new usage record', [
-                    'new_usage_id' => $newUsage?->id,
-                    'user_id' => $userId,
-                    'entity_type' => $entityType,
-                    'metric_type' => $metricType,
-                    'period_type' => $periodType,
-                    'current_value' => $value,
-                    'created' => $newUsage ? 'success' : 'failed'
