-            'EUR' => 0.85,
-            'CZK' => 21.5,
-            'GBP' => 0.73,
-            'PLN' => 3.8,
-            'HUF' => 300,
-            'CHF' => 0.92
-        ];
-    }
-
-    /**
-     * Convert amount from one currency to another
-     * 
-     * @param float $amount
-     * @param string $fromCurrency
-     * @param string $toCurrency
