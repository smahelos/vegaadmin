+     * @return bool
+     */
+    public function applyRefund(float $amount): bool
+    {
+        if ($amount <= 0) {
+            return false;
+        }
+        $current = (float) ($this->refunded_amount ?? 0.0);
+        $newTotal = round($current + $amount, 2);
+        $this->refunded_amount = (string) $newTotal; // decimal cast expects stringable numeric
