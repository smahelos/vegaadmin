-                    return self::createProvider('EU');
-            }
-        }
-
-        // Priority 4: Default to Czech provider
-        return self::createProvider('CZ');
-    }
-
-    /**
-     * Get property from invoice object or array
-     *
-     * @param mixed $invoice
-     * @param string $property
-     * @return mixed
-     */
-    private static function getInvoiceProperty($invoice, string $property): mixed
-    {
-        // Check object properties
-        if (is_object($invoice)) {
-            if (isset($invoice->$property)) {
-                return $invoice->$property;
-            }
-            
-            // Check supplier properties
-            if (isset($invoice->supplier) && isset($invoice->supplier->$property)) {
-                return $invoice->supplier->$property;
-            }
-        }
-        
-        // Check array keys
-        if (is_array($invoice)) {
-            if (isset($invoice[$property])) {
-                return $invoice[$property];
-            }
-        }
-        
-        return null;
-    }
-
-    /**
