-     * @param mixed $invoice Invoice object or data
-     * @return QrPaymentProviderInterface
-     */
-    public static function autoDetectProvider($invoice): QrPaymentProviderInterface
-    {
-        // Priority 1: Check if invoice has explicit country code
-        $countryCode = self::getInvoiceProperty($invoice, 'country_code');
-        if (!empty($countryCode)) {
-            try {
-                return self::createProvider($countryCode);
-            } catch (\InvalidArgumentException $e) {
-                // Invalid country code, continue to next detection method
-            }
-        }
-
-        // Priority 2: Detect from IBAN
-        $iban = self::getInvoiceProperty($invoice, 'iban');
-        if (!empty($iban)) {
-            $ibanCountryCode = strtoupper(substr(preg_replace('/\s+/', '', $iban), 0, 2));
-            
-            if (isset(self::$ibanCountryMapping[$ibanCountryCode])) {
-                $providerCountryCode = self::$ibanCountryMapping[$ibanCountryCode];
