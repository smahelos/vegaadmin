-    /**
-     * Check limit before creating entity
-     */
-    public function checkEntityLimit(
-        ?string $entityType = null,
-        string $limitType = 'count',
-        string $periodType = 'monthly',
-        int|float $value = 1
-    ): array {
-        $entityType = $entityType ?? $this->getEntityType();
-        $user = $this->getCurrentUser();
-        
-        if (!$user) {
-            return [
-                'allowed' => false, 
-                'reason' => 'unauthorized',
-                'entity_type' => $entityType,
-                'limit_type' => $limitType,
-                'period_type' => $periodType
-            ];
-        }
-        
-        $limitService = app(UniversalLimitService::class);
-        return $limitService->checkLimit($user, $entityType, $limitType, $periodType, $value);
-    }
-    
-    /**
-     * Record usage after creating entity
-     */
-    public function recordEntityUsage(
-        ?string $entityType = null,
-        string $limitType = 'count',
-        string $periodType = 'monthly',
-        int|float $value = 1
-    ): bool {
-        $entityType = $entityType ?? $this->getEntityType();
-        $user = $this->getCurrentUser();
-        
-        if (!$user) {
-            return false;
-        }
-        
-        $limitService = app(UniversalLimitService::class);
-        return $limitService->recordUsage($user, $entityType, $limitType, $periodType, $value);
-    }
-
-    /**
-     * Get usage statistics for current user and entity
-     */
-    public function getEntityUsageStatistics(
-        ?string $entityType = null,
-        string $limitType = 'count',
-        string $periodType = 'monthly'
-    ): ?array {
-        $entityType = $entityType ?? $this->getEntityType();
-        $user = $this->getCurrentUser();
-        
-        if (!$user) {
-            return null;
-        }
-        
-        $limitService = app(UniversalLimitService::class);
-        return $limitService->getUsageStatistics($user, $entityType, $limitType, $periodType);
-    }
-    
-    /**
-     * Get entity type from class name or override in child class
-     */
-    protected function getEntityType(): string
-    {
-        // Remove common suffixes to get entity name
-        $className = class_basename($this);
-        $cleanName = str_replace(['Request', 'Controller', 'CrudController'], '', $className);
-        
-        return strtolower($cleanName);
-    }
-    
-    /**
-     * Get current authenticated user - can be overridden in child classes
-     */
-    protected function getCurrentUser(): ?User
