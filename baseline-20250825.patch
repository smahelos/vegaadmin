-    /**
-     * Convenience method for recording product creation
-     */
-    public function recordProductCreation(?User $user, string $guard = 'web'): bool
-    {
-        $bestPeriod = $this->getBestPeriodType($user, 'product', 'count');
-        return $this->recordUsage($user, 'product', 'count', $bestPeriod, $guard, 1);
-    }
-
-    /**
-     * Check if user has permission for given entity type
-     * Independent of active/inactive limits - dynamically checks from database
-     */
-    private function hasEntityPermission(?User $user, string $entityType, string $guard = 'web'): bool
-    {
-        if (!$user) {
-            return false; // Anonymous users can't record usage
-        }
-
-        // Get all permissions that have limits configured for this entity type
-        $permissionsForEntity = EntityLimit::where('entity_type', $entityType)
-            ->distinct()
-            ->pluck('permission_name')
-            ->filter() // Remove null values
-            ->toArray();
-        
-        if (empty($permissionsForEntity)) {
-            Log::info('UELS: No permissions configured for entity type', [
-                'entity_type' => $entityType,
-                'user_id' => $user->id
-            ]);
-            return false;
-        }
-
-        // Check if user has any of the permissions configured for this entity
-        foreach ($permissionsForEntity as $permission) {
