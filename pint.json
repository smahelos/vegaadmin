{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "trailing_comma_in_multiline": {
            "elements": [
                "arguments",
                "arrays",
                "match",
                "parameters"
            ]
        },
        "not_operator_with_successor_space": false,
        "class_definition": {
            "multi_line_extends_each_single_line": true,
            "single_item_single_line": true,
            "single_line": true,
            "inline_constructor_arguments": false
        }
    },
    "exclude": [
        "data",
        "storage",
        "vendor",
        "node_modules",
        "backup",
        "dev_docs"
    ]
}
