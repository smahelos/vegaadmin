includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/tomasvotruba/type-coverage/config/extension.neon
    - vendor/shipmonk/dead-code-detector/rules.neon
    - phpstan/stubs.neon

parameters:
    level: 2
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - phpstan/
        - routes/
        - tests/
    excludePaths:
        # Fixtures of the rule tests, which hold the violations on purpose
        - tests/Unit/Phpstan/Rules/data/
    # Every own property has a native type (.claude/rules/php.md, Types); properties declared by a parent
    # class (Eloquent $fillable, Command $signature, ...) are not counted. Return and parameter types are
    # enforced by PHP_CodeSniffer (phpcs.xml), typed class constants need PHP 8.3.
    type_coverage:
        property: 100
        return: 0
        param: 0
        constant: 0
    # No unused method, property or constant (.claude/rules/php.md, Readability), including code only tests
    # call; factories are test code. Members that Backpack, Livewire, Blade and laravel/ui reach by name are
    # marked in phpstan/DeadCode.
    shipmonkDeadCode:
        usageExcluders:
            tests:
                enabled: true
                devPaths:
                    - %currentWorkingDirectory%/database/factories
                    - %currentWorkingDirectory%/tests

rules:
    - Billex\PHPStan\Rules\ScopeIssuedByGateRule
    - Billex\PHPStan\Rules\UseCaseResultRule

services:
    # Only the gate reads permissions and roles (rules/permissions.md)
    -
        class: Billex\PHPStan\Rules\PermissionsReadByGateRule
        arguments:
            paths:
                - %currentWorkingDirectory%/app/
                - %currentWorkingDirectory%/bootstrap/
                - %currentWorkingDirectory%/config/
                - %currentWorkingDirectory%/routes/
            gate: %currentWorkingDirectory%/app/Infrastructure/Authorization/
    # Application code: tests/ and database/ (seeders, migrations, factories) set roles directly (D-049)
    -
        class: Billex\PHPStan\Rules\RolesWrittenByRepositoryRule
        arguments:
            paths:
                - %currentWorkingDirectory%/app/
                - %currentWorkingDirectory%/bootstrap/
                - %currentWorkingDirectory%/config/
                - %currentWorkingDirectory%/routes/
        tags:
            - phpstan.rules.rule
    # Controllers that still call Eloquent; one leaves the list when its context is converted (docs/TECH_DEBT.md)
    -
        class: Billex\PHPStan\Rules\EloquentOutsideControllersRule
        arguments:
            controllers:
                - App\Http\Controllers\Admin\BankAccountCrudController
                - App\Http\Controllers\Admin\BusinessCrudController
                - App\Http\Controllers\Admin\ContactCrudController
                - App\Http\Controllers\Admin\DatabaseDashboardController
                - App\Http\Controllers\Admin\PageCrudController
                - App\Http\Controllers\Admin\StatusCrudController
                - App\Http\Controllers\Admin\SubscriptionPlanCrudController
                - App\Http\Controllers\Frontend\SubscriptionController
        tags:
            - phpstan.rules.rule
    -
        class: Billex\PHPStan\Collectors\EloquentCallCollector
        tags:
            - phpstan.collector
    # Files without an injection point that still look dependencies up (Backpack calls rules() of a request directly); one leaves the list when it is converted
    # (docs/TECH_DEBT.md, "Dependencies taken from the container")
    -
        class: Billex\PHPStan\Rules\ContainerLookupRule
        arguments:
            paths:
                - %currentWorkingDirectory%/app/
                - %currentWorkingDirectory%/bootstrap/
                - %currentWorkingDirectory%/config/
                - %currentWorkingDirectory%/routes/
            providers: %currentWorkingDirectory%/app/Providers/
            files:
                - %currentWorkingDirectory%/app/Http/Requests/Admin/InvoiceRequest.php
                - %currentWorkingDirectory%/app/Infrastructure/Notifications/Invoice/Messages/InvoiceDueReminder.php
                - %currentWorkingDirectory%/app/Infrastructure/Notifications/Invoice/Messages/InvoiceOverdueReminder.php
                - %currentWorkingDirectory%/app/Infrastructure/Notifications/Invoice/Messages/InvoiceUpcomingDueReminder.php
                - %currentWorkingDirectory%/app/Infrastructure/Shared/File/Traits/HasFileUploads.php
                - %currentWorkingDirectory%/routes/console.php
        tags:
            - phpstan.rules.rule
    -
        class: Billex\PHPStan\Collectors\ContainerLookupCollector
        tags:
            - phpstan.collector
    -
        class: Billex\PHPStan\DeadCode\BackpackUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider
    -
        class: Billex\PHPStan\DeadCode\BladeComponentUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider
    -
        class: Billex\PHPStan\DeadCode\BladeTemplateUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider
    -
        class: Billex\PHPStan\DeadCode\LivewireUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider
    -
        class: Billex\PHPStan\DeadCode\RedirectsUsersUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider
    -
        class: Billex\PHPStan\DeadCode\UseCaseHandlerUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider
