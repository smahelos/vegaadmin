
[mysqld]
bind_address                        = 0.0.0.0
tmpdir                              = /dev/shm
character-set-server                = utf8mb4
collation-server                    = utf8mb4_unicode_ci
skip-name-resolve                   = 1
explicit_defaults_for_timestamp     = 1 # needed because of deprecation od DEFAULT value
#default-time-zone               = "+02:00"
#sql_mode                       =  ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
#sql_mode                        =  STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# Innodb parameters
innodb_buffer_pool_size         = 512M        #4 Generally, set to 50%–70% of total RAM. It does not need to be larger than the total database size.)
innodb_log_file_size            = 512M
#innodb_redo_log_capacity        = 512M
innodb_log_buffer_size          = 128M
innodb_flush_log_at_trx_commit  = 0         # 1=default, 0/2 = more performance, less reliability. 0 means flush to disk, but do not sync, 2 means don’t flush and don’t sync
innodb_flush_method             = O_DIRECT  # avoid double buffering
innodb_flush_neighbors          = 0         # from ON to conserve CPU SSD has no rotational delay
innodb_flushing_avg_loops       = 10        # from 30 to reduce loop delays
innodb_file_per_table           = 1         # Setting this to “ON” will generate an independent InnoDB table space for every table in the database.
innodb_lru_scan_depth           = 100       #256 100 from 1024 to reduce CPU cycles used every second for function
innodb_purge_threads            = 4         # from 1 to expedite purge activity
innodb_stats_on_metadata        = 0         # Setting this to “OFF” avoids unnecessary updating of InnoDB statistics and can greatly improve read speeds.
innodb_io_capacity              = 400      #400; 2500 Default 200 (https://www.percona.com/blog/2020/05/14/tuning-mysql-innodb-flushing-for-a-write-intensive-workload/)
innodb_io_capacity_max          = 4000      # Default 2000
innodb_autoinc_lock_mode        = 2
#innodb_buffer_pool_chunk_size   = 546308096
# Setting innodb_autoinc_lock_mode =2 (interleaved mode) can remove the need for table-level AUTO-INC lock (and can increase performance when multi-row insert statements are used to insert values into tables with auto_increment primary key). This requires binlog_format=ROW  or MIXED  (ROW is default in MySQL 5.7)

# Buffers sizes - the best practice: stay with default values
key_buffer_size                 = 0          # 16M;
join_buffer_size                = 4M        # As a rule of thumb you should set 1M for each GB of used memory in MySQL.
#read_buffer_size                = 128K      # default = 128K.
sort_buffer_size                = 1M        # 2M from 16M requested per connection
read_rnd_buffer_size            = 128K      #IDX from 256K to reduce handler_read_rnd_next RPS of 4,957

thread_cache_size               = 256       # 100 from 128K for CAP suggested in 5.7 REFMAN. # 100 from 256 for CAP see refman V8 to avoid OOM
#thread_pool_size                = 32        # from 32M  a major difference
table_open_cache                = 64k      # 1024 from 256M that would be a LOT of open tables
table_definition_cache          = 1024      # 512 from 256M The number of user-defined tables + 10%
max_connect_errors              = 10        # from 100 why give a hacker/cracker so many attempts?
max_connections                 = 100       # default is 151. Was 400
max_allowed_packet              = 128M

# BINLOGS (# SHOW VARIABLES LIKE 'log_bin'; SHOW VARIABLES LIKE 'log_bin_basename'; Clean old logs: PURGE BINARY LOGS TO 'binlog-bin.000039';)
disable_log_bin                             # use without params. Disables binlog. To turn log off you have to comment log-bin nad binlog_* as well
sync_binlog                     = 0         # If your MySQL server has no slaves and you don’t do backups
#log-bin                         = /var/lib/mysql/binlog
log_bin_trust_function_creators = 1         # Has to be set if Magento indexer raise an error: "You do not have the SUPER privilege and binary logging is enabled
#binlog_space_limit              = 5G
#binlog_expire_logs_seconds      = 864000    # Default = 2592000 (30days)

# PERFORMANCE log settings
innodb_monitor_enable           = all
performance_schema              = ON
#userstat                        = 1

# SLOW log config
log_output                      = FILE
slow_query_log                  = OFF
slow_query_log_file             = /var/lib/mysql/mysql_slow.log
#max_slowlog_size                = 100M     # Not ported to v8 yet
#max_slowlog_files               = 10       # Not ported to v8 yet
long_query_time                 = 2         # 1
log_slow_admin_statements       = OFF       # slow_query_log has to be ON otherwise set this to OFF
log_slow_slave_statements       = OFF
log_queries_not_using_indexes   = OFF       # slow_query_log has to be ON otherwise set this to OFF
#log_slow_verbosity              = query_plan,explain # full

#max_write_lock_count=16  # to allow RD after nn write lcks vs up to ~4 Billion lcks

[mysqldump]
max_allowed_packet                  = 1024M
quick


